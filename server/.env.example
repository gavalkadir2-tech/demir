# --- Yerel PostgreSQL kullanacaksanız ---
# DATABASE_URL="postgresql://demirci:demirci_dev_pw@localhost:5432/demirci_db?schema=public"

# --- Supabase kullanacaksanız (Project Settings > Connect > ORMs > Prisma'dan alın) ---
# DATABASE_URL: havuzlu bağlantı (uygulama çalışırken kullanılır, port 6543)
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: doğrudan bağlantı (sadece "prisma migrate" komutları için kullanılır, port 5432)
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

PORT=4000

# --- AI özellikleri (doğal dille iş oluşturma vb.) için ---
# aistudio.google.com/apikey adresinden ücretsiz alınan bir Gemini API anahtarı. Boş bırakılırsa AI özellikleri devre dışı kalır.
GEMINI_API_KEY=

# --- Giriş (uygulamayı şifreyle koru) için ---
# Boş bırakılırsa varsayılan "DemirciAtolye2026!" kullanılır - değiştirmek için ayarlayın.
APP_PASSWORD=

# Oturum çerezini imzalamak için rastgele, uzun bir metin (örn. `openssl rand -hex 32`). Boş
# bırakılırsa geçici bir anahtar kullanılır ve her deploy'da tüm oturumlar sıfırlanır.
SESSION_SECRET=

# Girişe izin verilen tek e-posta (kullanıcı adı olarak kullanılır). Boş bırakılırsa varsayılan
# olarak gavalkadir2@gmail.com kullanılır.
ALLOWED_EMAIL=
